                "summary": "Login and generate OTP",
                "description": "Login using Sanctum - now generates OTP.",
                "operationId": "8dcb70df1020986038d098cc08d05dae",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
